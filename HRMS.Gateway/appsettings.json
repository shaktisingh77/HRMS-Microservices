{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "employee-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/employees/{**catch-all}"
        }
      },
      "payroll-route": {
        "ClusterId": "payroll-cluster",
        "Match": {
          "Path": "/api/payroll/{**catch-all}"
        }
      },
      "leave-route": {
        "ClusterId": "leave-cluster",
        "Match": {
          "Path": "/api/leave/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "employee-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7206/"
          }
        }
      },
      "payroll-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7211/"
          }
        }
      },
      "leave-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7207/"
          }
        }
      }
    }
  }
}